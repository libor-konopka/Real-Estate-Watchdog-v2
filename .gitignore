*.py[cod]
*$py.class

# --- Secrets and identities (Environment variables) ---
.env
.env.*
!.env.example
*.pem

# --- Physical storage and volumes (Docker, Lakehouse, Data) ---
data/*
!data/static/
postgres_data/
minio_data/

# --- Orchestration and logs (Dagster, Loguru) ---
dagster_home/
logs/
*.log
.tmp_dagster_home*/
